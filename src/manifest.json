{
  "name": "Proxy Manager",
  "version": "1.5.0",
  "description": "Простой прокси-менеджер: HTTP/SOCKS4/SOCKS5, профили, проверка",
  "manifest_version": 3,
  "permissions": [
    "proxy",
    "storage"
  ],
  "host_permissions": [
    "https://www.gstatic.com/*",
    "https://ipwho.is/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Proxy Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}